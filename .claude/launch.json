{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Jekyll Frontend",
      "runtimeExecutable": "bundle",
      "runtimeArgs": [
        "exec",
        "jekyll",
        "serve",
        "--livereload",
        "--port",
        "4000"
      ],
      "port": 4000
    },
    {
      "name": "Jekyll Windows",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set PATH=C:\\Ruby33-x64\\bin;%PATH% && bundle exec jekyll serve --livereload --port 4000"
      ],
      "port": 4000
    }
  ]
}
