rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Het beoordelingssysteem (submissions/results) is uitgefaseerd; Informatica
    // draait op northgo-informatica.nl. Dit project wordt alleen nog gebruikt
    // voor de privé docent-pagina's (docent/demos.html op servaaswinder.nl).
    // Alles wat hieronder niet expliciet gematcht wordt, is dicht.

    // Wie mag meelezen. Inloggen kan via Google of e-mail+wachtwoord; de toegang
    // hangt alleen aan het geverifieerde e-mailadres, niet aan de inlogmethode.
    function isBeheerder() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'servaas.winder@northgo-college.nl';
    }

    function magLezen() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'servaas.winder@northgo-college.nl',
          'janneke.koomen@northgo-college.nl'
        ];
    }

    match /docent/{docId} {
      allow read: if magLezen();
      allow write: if isBeheerder();
    }
  }
}
