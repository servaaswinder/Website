rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dit project wordt alleen nog gebruikt voor docent/demos.html.
    // Alles wat hieronder niet expliciet gematcht wordt, is dicht.

    // Wie toegang heeft staat in de collectie `toegang`: document-id is het
    // e-mailadres, veld `beheerder: true` geeft schrijfrechten. Die collectie
    // is zelf dicht voor de browser; beheer via de Firebase-console.
    function magLezen() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/toegang/$(request.auth.token.email));
    }

    function isBeheerder() {
      return magLezen() &&
        get(/databases/$(database)/documents/toegang/$(request.auth.token.email)).data.beheerder == true;
    }

    match /docent/{docId} {
      allow read: if magLezen();
      allow write: if isBeheerder();
    }
  }
}
